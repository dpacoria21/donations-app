                "type": "text/javascript",
                "exec": [
                  "pm.test('201 Created', () => pm.response.to.have.status(201));",
                  "const body = pm.response.json();",
                  "pm.test('Nace en BORRADOR con 0 recaudado', () => { pm.expect(body.status).to.eql('BORRADOR'); pm.expect(body.confirmedAmountCents).to.eql(0); });",
