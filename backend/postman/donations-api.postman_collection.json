  "item": [
    {
      "name": "Proyectos (público)",
      "item": [
        {
          "name": "T01 — Listar proyectos publicados",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/v1/projects",
            "description": "T01 · CA-01.1 · CA-01.2: 200 y sin borradores."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('items es un arreglo', () => pm.expect(body.items).to.be.an('array'));",
                  "pm.test('Solo proyectos PUBLICADO (CA-01.2)', () => body.items.forEach((p) => pm.expect(p.status).to.eql('PUBLICADO')));",
                  "pm.test('El borrador no aparece', () => pm.expect(body.items.map((p) => p.projectId)).to.not.include(pm.collectionVariables.get('draftProjectId')));",
                  "pm.test('Montos en céntimos enteros y PEN', () => body.items.forEach((p) => {",
                  "  pm.expect(Number.isInteger(p.goalAmountCents)).to.be.true;",
                  "  pm.expect(Number.isInteger(p.confirmedAmountCents)).to.be.true;",
                  "  pm.expect(p.currency).to.eql('PEN');",
                  "}));",
                  "pm.test('Sin datos de donantes (CA-09.2)', () => pm.expect(pm.response.text()).to.not.include('donorSub'));"
                ]
              }
            }
          ]
        },
        {
          "name": "HU-02 — Detalle de proyecto publicado",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/v1/projects/{{publishedProjectId}}",
            "description": "CA-02.1: identificador, descripción, objetivo, estado y monto acumulado."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('Campos públicos esperados', () => pm.expect(body).to.have.all.keys('projectId', 'title', 'description', 'goalAmountCents', 'confirmedAmountCents', 'currency', 'status'));",
                  "pm.test('Es el proyecto pedido', () => pm.expect(body.projectId).to.eql(pm.collectionVariables.get('publishedProjectId')));"
                ]
              }
            }
          ]
        },
        {
          "name": "CA-02.2 — Detalle de un BORRADOR → 404",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/v1/projects/{{draftProjectId}}",
            "description": "Un proyecto no publicado devuelve 404 sin revelar contenido."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('404 Not Found', () => pm.response.to.have.status(404));",
                  "pm.test('Código NOT_FOUND', () => pm.expect(pm.response.json().code).to.eql('NOT_FOUND'));",
                  "pm.test('No revela el contenido del borrador', () => pm.expect(pm.response.text()).to.not.include('Biblioteca'));"
                ]
              }
            }
          ]
        },
        {
          "name": "CA-02.2 — Detalle de proyecto inexistente → 404",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/v1/projects/{{missingProjectId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('404 Not Found', () => pm.response.to.have.status(404));",
                  "pm.test('Código NOT_FOUND', () => pm.expect(pm.response.json().code).to.eql('NOT_FOUND'));"
                ]
              }
            }
          ]
        },
