{
  "name": "donations-backend",
  "version": "0.1.0",
  "private": true,
  "description": "API serverless (AWS Lambda + API Gateway HTTP API) de la Plataforma de Donaciones Seguras",
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env --watch dev/server.ts",
    "start": "node --env-file-if-exists=.env dev/server.ts",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "node scripts/build.ts",
    "lint:api": "redocly lint ../docs/api.yaml",
    "check": "npm run lint && npm run lint:api && npm run format:check && npm run typecheck && npm run test && npm run build",
    "seed:projects": "node --env-file-if-exists=.env scripts/seed-projects.ts",
    "evidence:t08": "node scripts/t08-concurrency.ts",
    "setup:mfa": "node --env-file-if-exists=.env scripts/setup-mfa.ts"
  },
  "dependencies": {
    "@aws-sdk/client-cognito-identity-provider": "3.1167.0",
    "@aws-sdk/client-dynamodb": "3.1167.0",
    "@aws-sdk/lib-dynamodb": "3.1167.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@redocly/cli": "2.77.0",
    "@types/aws-lambda": "8.10.164",
    "@types/node": "24.19.2",
    "aws-jwt-verify": "5.2.1",
    "aws-sdk-client-mock": "4.1.0",
    "esbuild": "0.28.2",
    "eslint": "10.14.0",
    "globals": "17.14.0",
    "prettier": "3.10.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2",
    "vitest": "5.1.0",
    "yaml": "2.9.1"
  }
}
