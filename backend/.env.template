# Plantilla de configuración del backend. Copiar a `.env` (ignorado por Git) y completar:
#   cp .env.template .env
#
# NO guardar aquí llaves de acceso de AWS (AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY):
# el proyecto usa credenciales temporales con `aws login --profile donations-dev`
# (CA-NF03.2, CA-NF03.3). Este archivo solo lleva configuración y nombres de recursos.

# --- Servidor local de desarrollo (npm run dev) ---
PORT=3000
# Orígenes del frontend admitidos por CORS, separados por comas.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- AWS (fase 2: SAM y DynamoDB) ---
AWS_REGION=us-east-2
AWS_PROFILE=donations-dev
STAGE=academic

# --- Tablas DynamoDB (se completan tras `sam deploy`) ---
PROJECTS_TABLE=
DONATIONS_TABLE=
IDEMPOTENCY_TABLE=
AUDIT_EVENTS_TABLE=

# --- Cognito (identificadores públicos; se completan tras crear el user pool) ---
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=
