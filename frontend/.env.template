# Plantilla de configuración del frontend. Copiar a `.env` (ignorado por Git) y completar:
#   cp .env.template .env
#
# IMPORTANTE: Vite incrusta las variables VITE_* en el JavaScript que se publica, así que
# son PÚBLICAS. Nunca poner aquí secretos, contraseñas, client secrets ni llaves de AWS.
# El app client de Cognito para la SPA es público (sin secreto) y usa PKCE (CA-03.1).

# URL base del API: el servidor local (backend: npm run dev) o el stage de API Gateway.
VITE_API_BASE_URL=http://127.0.0.1:3000

# --- Cognito (fase 2; se completan tras crear el user pool) ---
# Emisor OIDC: https://cognito-idp.us-east-2.amazonaws.com/<userPoolId>
VITE_COGNITO_AUTHORITY=
VITE_COGNITO_CLIENT_ID=
# Dominio del managed login, sin barra final: https://<prefijo>.auth.us-east-2.amazoncognito.com
VITE_COGNITO_DOMAIN=
VITE_COGNITO_REDIRECT_URI=http://localhost:5173/auth/callback
VITE_COGNITO_LOGOUT_URI=http://localhost:5173/
